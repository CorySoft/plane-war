# ============================================================
# 站点根重写：把请求落到 htdocs/wwwroot（游戏真正所在目录）
#
# 关键修正：判定文件是否存在必须用 RewriteRule 的 $1 捕获组，
# 而不是 %{REQUEST_URI}——后者包含查询串（如 /js/game.js?v=0.1.8），
# 拼出来的路径 "-f" 永远失败，版本化模块会被误转发到 index.php → 404，
# 表现为「进度条走到 100% 后提示加载失败」。
# ============================================================
RewriteEngine On

# 0.1) 禁止访问服务端日志与节流文件（位于 wwwroot/，含用户提交的敏感内容）。
#      用 mod_rewrite 返回 403，只依赖 FileInfo（与下方 RewriteRule 同级，已被 Byethost 允许），
#      避免 Require/AllowOverride 不被允许时整站 500。必须放在通用 ^(.+)$ 重写之前以优先匹配。
#
#      注意：per-directory 上下文中 RewriteRule 匹配的是「剥掉本目录前缀后的相对路径」。
#      本文件位于 htdocs/，而日志在 htdocs/wwwroot/ 下，请求 /wwwroot/feedback.log 时
#      匹配串是 "wwwroot/feedback.log"，所以必须带 wwwroot/ 前缀，
#      只写 ^(feedback\.log)$ 是匹配不到的（日志会被原样下载）。
#      两条都保留：既挡 /wwwroot/feedback.log，也挡万一文件被放到根部的同名文件。
RewriteRule ^wwwroot/(feedback\.log|\.push_throttle)$ - [F]
RewriteRule ^(feedback\.log|\.push_throttle)$ - [F]
# 隐藏文件（.push_throttle 之类）与备份文件一律 403（.well-known 放行，否则 ACME 校验会挂）
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule (^|/)\.[^/]+$ - [F]
RewriteRule \.(bak|old|log|sql|env)$ - [F]

# 1) 根路径 → 游戏首页
RewriteCond %{DOCUMENT_ROOT}/wwwroot/index.html -f
RewriteRule ^$ wwwroot/index.html [L]

# 2) 静态资源（js/css/图片，含 ?v= 版本查询串）直接提供
RewriteCond %{DOCUMENT_ROOT}/wwwroot/$1 -f
RewriteRule ^(.+)$ wwwroot/$1 [L]

# 3) 目录 → 该目录下的 index.html
RewriteCond %{DOCUMENT_ROOT}/wwwroot/$1/index.html -f
RewriteRule ^(.+)$ wwwroot/$1/index.html [L]

# 4) 目录列表兜底 403：/js/ 之类直接列目录会把所有历史版本文件枚举出来。
#    刻意不用 Options -Indexes：本空间 AllowOverride 只放开 FileInfo，
#    写 Options 会触发 500 让整站挂掉；这里同样只依赖 mod_rewrite。
#    位置必须在规则 3 之后——真实存在的目录已被上面的 [L] 提前处理掉。
#    两个 Cond 分别覆盖 /js/ 与 /wwwroot/js/ 两种写法（REQUEST_URI 里带不带 wwwroot 前缀）。
RewriteCond %{DOCUMENT_ROOT}/wwwroot/$1 -d [OR]
RewriteCond %{DOCUMENT_ROOT}/$1 -d
RewriteRule ^(.+)$ - [F]

# ============================================================
# MIME 兜底：ES module 必须以 JavaScript 类型返回，
# 否则浏览器会因「MIME 类型不是 JS」直接拒绝执行整个模块图。
# ============================================================
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType application/json .json
</IfModule>

# ============================================================
# 破除静态缓存（Byethost 静态文件可能带长缓存头）
# ============================================================
<IfModule mod_headers.c>
  <FilesMatch "\.(js|mjs|html|css|json)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>
