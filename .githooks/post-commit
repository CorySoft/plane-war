#!/usr/bin/env bash
# post-commit — git 提交后自动增量部署到 Byethost FTP
# 启用：git config core.hooksPath .githooks
# 跳过本次部署：SKIP_DEPLOY=1 git commit ...
#
# 安全网（2026 修订）：
#   1) 部署前先过 deploy.sh 内的测试门禁（npm test），失败即中止、不部署
#   2) 默认走增量上传（--only-newer），不再每次全量 --force
#   3) 失败以非零退出码返回并在终端提示，不再无条件 exit 0
#   4) SKIP_DEPLOY=1 单次跳过开关（本轮新增，见下）
set -u

# 单次跳过开关。注意：git commit --no-verify 只绕过 pre-commit / commit-msg，
# **不会**跳过 post-commit（实测两次提交均触发本钩子），旧文档把它当成跳过方式是错的。
# 需要「只入库不上线」时用：SKIP_DEPLOY=1 git commit -m "..."
if [ "${SKIP_DEPLOY:-0}" = "1" ]; then
  echo "== SKIP_DEPLOY=1，跳过本次自动部署 =="
  exit 0
fi

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

# 需要 .deploy.env 存在且是否有变更文件
if [ ! -f ".deploy.env" ]; then
  exit 0
fi

# 只在实际修改了可部署文件时才部署。
# 排除：测试、CI 配置、工具脚本、文档、部署脚本自身、包管理与版本文件——
# 这些都不进 wwwroot/，不该触发一次生产部署 + 版本号连环 +1。
changed=$(git diff-tree --no-commit-id --name-only -r HEAD 2>/dev/null \
  | grep -Ev '^(test/|test-results/|\.github/|tools/|\.githooks/|node_modules/|VERSION$|js/version\.js$|\.gitignore$|deploy\.sh$|package(-lock)?\.json$|.*\.md$)' || true)
if [ -z "$changed" ]; then
  exit 0
fi

echo "== 检测到变更，执行增量部署（含 npm test 门禁）=="
# 使用默认增量模式；deploy.sh 内部先跑测试，未通过则中止且不改 VERSION
bash "$ROOT/deploy.sh" > /tmp/plane_war_auto_deploy.log 2>&1
status=$?
if [ $status -eq 0 ]; then
  echo "（自动部署成功）"
else
  echo "（自动部署失败或被测试门禁拦截，详见 /tmp/plane_war_auto_deploy.log）"
fi
exit $status
